{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "@cauthyhq/react": ["./src/index.ts"]
    }
  },
  "include": ["src", "test", "e2e"],
  "exclude": ["node_modules", "dist", "e2e/app/dist", "examples"]
}
