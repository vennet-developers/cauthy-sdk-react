{
  "name": "@cauthyhq/react",
  "version": "1.0.0",
  "description": "Cauthy for React: hooks and headless sign-in, account and organization components with a default theme.",
  "license": "Apache-2.0",
  "author": "Vennet Developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vennet-developers/cauthy-sdk-react.git"
  },
  "homepage": "https://github.com/vennet-developers/cauthy-sdk-react#readme",
  "bugs": "https://github.com/vennet-developers/cauthy-sdk-react/issues",
  "cauthy": {
    "protocol": 1
  },
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:fixtures": "sh scripts/check-fixtures.sh",
    "check:package": "sh scripts/check-package.sh",
    "check:size": "node scripts/check-size.mjs",
    "ssr:smoke": "sh scripts/ssr-smoke.sh",
    "e2e:build": "vite build --config e2e/app/vite.config.ts",
    "e2e:node": "npm run e2e:build && E2E_BACKEND=node playwright test",
    "e2e:record": "npm run e2e:build && E2E_BACKEND=record playwright test --project chromium",
    "e2e:fixture": "npm run e2e:build && E2E_BACKEND=fixture playwright test",
    "e2e:go": "npm run e2e:build && E2E_BACKEND=go playwright test",
    "prepublishOnly": "node scripts/no-file-deps.mjs && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@cauthyhq/js": "^1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "cauthy",
    "auth",
    "authentication",
    "react",
    "sign-in",
    "passkey",
    "nextjs",
    "bff"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@cauthyhq/node": "^1.0.0",
    "@playwright/test": "1.56.1",
    "@types/express": "5.0.6",
    "@types/node": "20.19.41",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.10.3",
    "cauthy-auth": "0.42.0",
    "express": "5.3.0",
    "jsdom": "26.1.0",
    "publint": "0.3.25",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  },
  "overrides": {
    "tsup": {
      "esbuild": "0.28.2"
    }
  }
}
